  "strings" : {
    "%@: %@ %@" : {
      "comment" : "A label that describes a language and its associated speech recognition capability. The first argument is the display name of the language. The second argument is the speech recognition capability (e.g. \"mic\" or \"speaker\"). The third argument is the string “settings.offline.onDevice”, the string “settings.offline.onlineOnly” or the string “settings.offline.unavailable”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ %3$@"
          }
        }
      }
    },

    "error.speechPermissionDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Microphone and Speech Recognition access in Settings to use voice input."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro použití hlasového vstupu povolte v Nastavení přístup k mikrofonu a rozpoznávání řeči."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати голосовий ввід, увімкніть у Налаштуваннях доступ до мікрофона та розпізнавання мовлення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать голосовой ввод, разрешите в Настройках доступ к микрофону и распознаванию речи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete používať hlasový vstup, povoľte v Nastaveniach prístup k mikrofónu a rozpoznávaniu reči."
          }
        }
      }
    },
    "error.speechUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition isn't available right now."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání řeči momentálně není k dispozici."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення зараз недоступне."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи сейчас недоступно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávanie reči momentálne nie je k dispozícii."
          }
        }
      }
    },
    "error.tooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is too long to translate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento text je příliš dlouhý na překlad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей текст занадто довгий для перекладу."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот текст слишком длинный для перевода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento text je príliš dlhý na preklad."
          }
        }
      }
    },
    "error.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation took too long and timed out."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlad trval příliš dlouho a vypršel časový limit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклад тривав занадто довго, і час очікування вичерпано."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод занял слишком много времени, и время ожидания истекло."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklad trval príliš dlho a vypršal časový limit."
          }
        }
      }
    },
    "error.unsupportedApiVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app version is no longer supported. Please update."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omlouváme se, ale je nutné aplikaci aktualizovat, jinak nebude dále fungovat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибачте, але додаток необхідно оновити, інакше він не зможе працювати далі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извините, но приложение необходимо обновить, иначе оно больше не будет работать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ospravedlňujeme sa, ale je nutné aplikáciu aktualizovať, inak nemôže ďalej fungovať."
          }
        }
      }
    },
    "error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the translation service. Check your connection."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze se připojit k překladové službě. Zkontrolujte připojení k internetu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв'язатися зі службою перекладу. Перевірте підключення до інтернету."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться со службой перевода. Проверьте подключение к интернету."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa pripojiť k prekladovej službe. Skontrolujte internetové pripojenie."
          }
        }
      }
    },
    "error.decoding": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

            "state": "translated",
            "value": "Během překládání se texty automaticky ukládají a zde je jejich historie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час перекладу тексти зберігаються автоматично. Ви можете побачити тут їхню історію."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

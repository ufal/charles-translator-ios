    "error.unsupportedPair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot translate between these two languages."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi těmito dvěma jazyky nelze překládat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо перекласти між цими двома мовами."

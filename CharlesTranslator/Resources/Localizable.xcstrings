    "This deletes your saved history and resets your privacy choices. This can't be undone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto smažete uloženou historii a obnovíte svá nastavení ochrany soukromí. Tento krok nelze vrátit."
          }
        },
